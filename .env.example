# Postgres connection string from your Supabase project.
# Settings -> Database -> Connection string -> URI.
# Use the "Transaction" pooler (port 6543) — it's what works from serverless functions.
DATABASE_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres

# YouTube Data API v3 key. Fase 1 only needs a plain API key (no OAuth) —
# see docs/youtube-api.md for exactly which Google Cloud steps this requires.
YOUTUBE_API_KEY=

# Used for AI segment classification (docs/roadmap.md, Fase 1 item 6).
ANTHROPIC_API_KEY=
